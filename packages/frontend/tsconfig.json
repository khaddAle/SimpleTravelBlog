{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"],
  "exclude": ["dist", "node_modules"]
}
